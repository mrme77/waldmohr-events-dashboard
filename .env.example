# Google Calendar private iCal feed for the family layer.
# Google Calendar -> Settings -> [your calendar] -> "Integrate calendar" ->
# "Secret address in iCal format". Anyone with this URL can read the whole
# calendar — keep it out of git and out of chat logs.
GCAL_ICS_URL=

# Optional for new Homburg translations during a manual local refresh.
# Scheduled GitHub Actions refreshes use a repository secret with this name.
# The Pi display does not need this key.
OPENROUTER_API_KEY=
